# ProxiSpeak Environment Variables

# Node & Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=super_secret_proxispeak_jwt_token_key_change_in_production
JWT_EXPIRES_IN=7d

# Database
# If left empty or mongodb is unreachable locally, an in-memory embedded MongoDB starts automatically for seamless local execution
MONGODB_URI=mongodb://localhost:27017/proxispeak

# Redis (Optional: falls back to in-memory event bus if unavailable)
REDIS_URL=redis://localhost:6379

# Proximity Engine Settings (Planar 2D Cartesian Coordinates in Pixels)
PROXIMITY_RADIUS=100
PROXIMITY_EXIT_RADIUS=120
SPATIAL_GRID_CELL_SIZE=100

# WebRTC & Audio Configuration
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
