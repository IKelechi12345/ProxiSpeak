{
  "name": "proxispeak",
  "version": "1.0.0",
  "description": "ProxiSpeak - Geospatial Proximity Audio Ecosystem",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm --prefix server run dev",
    "build:shared": "npm --prefix shared run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "test": "npm --prefix server test",
    "test:client": "npm --prefix client test"
  },
  "keywords": [
    "webrtc",
    "spatial-audio",
    "geospatial",
    "proximity",
    "virtual-office",
    "mern"
  ],
  "author": "ProxiSpeak Team",
  "license": "MIT"
}
